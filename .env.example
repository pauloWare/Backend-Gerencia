# ============================================================================
# Modelo das variáveis de ambiente do backend (NÃO contém segredos reais).
#
# Uso local:
#   cp .env.example .env     # e preencha os valores
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# O .env NÃO é lido automaticamente pelo Spring: ele é carregado no shell com
# `source`, e as variáveis SPRING_* exportadas sobrescrevem os padrões de
# src/main/resources/application.properties (sem sobrescrever o que já estiver
# definido no ambiente). Mantenha a URL JDBC entre aspas — ela contém ";".
# O arquivo está no .gitignore e no .dockerignore (não é versionado).
#
# Observação: `./mvnw test` usa sempre o H2 em memória e ignora as variáveis
# SPRING_DATASOURCE_* (configurado no plugin surefire do pom.xml).
#
# Em produção (Render/Supabase) estas MESMAS variáveis são definidas no painel
# do provedor de hospedagem — o arquivo .env não é enviado para lá.
# ============================================================================

# ---------------------------------------------------------------------------
# SQL Server local (padrão do application.properties)
# Para PostgreSQL/Supabase em produção troque a URL para, por exemplo:
#   jdbc:postgresql://<host>:5432/<banco>?sslmode=require
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL="jdbc:sqlserver://localhost:1433;databaseName=academiaINF2CN;encrypt=true;trustServerCertificate=true"
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=troque-pela-senha-do-usuario-sa

# Opcional: só informe para forçar um driver. Em branco o Spring Boot deduz
# o driver a partir da URL (SQL Server ou PostgreSQL).
# SPRING_DATASOURCE_DRIVER=

# ---------------------------------------------------------------------------
# JPA / Hibernate
# ---------------------------------------------------------------------------
# Em produção use false para não registrar o SQL executado nos logs.
SPRING_JPA_SHOW_SQL=true

# ---------------------------------------------------------------------------
# Autenticação JWT
# ---------------------------------------------------------------------------
# Segredo HS256 com no mínimo 32 caracteres. Gere um valor local próprio, por
# exemplo: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRATION_MINUTES=120

# ---------------------------------------------------------------------------
# CORS — origens do FRONTEND autorizadas a chamar a API (não é o endereço da API)
# ---------------------------------------------------------------------------
# Opcional: se não for definida, vale o padrão do application.properties
# (localhost/127.0.0.1 e o IP local 192.168.0.32 em qualquer porta + Vercel).
# Use para trocar o IP da máquina (Expo Go / Expo Web no celular) ou acrescentar
# um domínio de produção. Separe por vírgulas. NÃO use "*".
# Exemplo com outro IP de rede:
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://192.168.0.50:*,https://gerencia-sigma.vercel.app
